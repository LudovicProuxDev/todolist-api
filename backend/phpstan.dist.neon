includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon

parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # Generated by Symfony
        - config/reference.php
    ignoreErrors:
        # Generated by Symfony
        -
            identifier: function.alreadyNarrowedType
            path: tests/bootstrap.php
