# Compose secrets: copy to .env (not versioned) and set the values
# The database passwords are used in URLs: avoid @ : / ? # % characters

# Application Postgres server: root (administration), todolist_app (todolist), todolist_test (todolist_test)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
TEST_DB_PASSWORD=

GRAFANA_ADMIN_PASSWORD=
SONAR_DB_PASSWORD=
