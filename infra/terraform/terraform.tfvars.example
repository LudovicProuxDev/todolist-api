# Copier en "terraform.tfvars" (non commité : mot de passe en clair).

project_name = "todolist"
environment  = "dev"
location     = "East US"

postgres_admin_username = "psqladmin"
postgres_admin_password = "ChangeMoi123" # fort, sans @ : / ? # %

# Azure Container Registry (créé par défaut, SKU Basic).
# enable_container_registry = true
# acr_sku                   = "Basic"

# Placeholder par défaut. Pour les vraies images, les pousser dans l'ACR
# créé par Terraform puis renseigner le login server :
# backend_docker_image  = "acrtodolistdevxxxxx.azurecr.io/todolist-backend:latest"
# backend_port          = 8000
# frontend_docker_image = "acrtodolistdevxxxxx.azurecr.io/todolist-frontend:latest"
# frontend_port         = 3000

# Frontend (React/Vite) : conteneur dans le même groupe ACI.
# enable_frontend           = true
# frontend_api_proxy_target = "http://localhost:8000"  # défaut : localhost:<backend_port>
# frontend_allowed_hosts    = "all"                    # ou "todolist-dev-xxxxx.eastus.azurecontainer.io"
